# DigitalMate Web configuration
# Copy to .env.local for Vite, or export in the shell / compose before
# `npm run dev`, `npm run preview` or `npm run start`.
# Without Orbit values the app stays on the fully local, account-free mock.

# ---------------------------------------------------------------------------
# Bridge server (services/bridge, Docker)
# ---------------------------------------------------------------------------
# Bind address and port for the standalone static + API server.
# HOST=127.0.0.1
# PORT=4173

# ---------------------------------------------------------------------------
# Orbit gateway (optional)
# ---------------------------------------------------------------------------
# Jiuwen/Orbit gateway WebSocket endpoint. wss:// is required.
ORBIT_GATEWAY_URL=wss://gateway.example.com/orbit/ws?binding_id=default

# Prefer a token file outside the repository. Never commit a real token.
# Mount it read-only into the container when self-hosting.
# ORBIT_TOKEN_FILE=/absolute/path/to/orbit-token

# Temporary local testing only.
# ORBIT_TOKEN=

# Optional Agent DX binding override.
# ORBIT_BINDING_ID=default

# Only for a local/self-hosted plain-ws gateway. Keep unset for production.
# ORBIT_ALLOW_INSECURE_WS=1

# Extra origins allowed to call the bridge. Same-origin requests are always
# allowed. Add the exact origins used by separately hosted or native clients,
# for example the Capacitor shell. Comma-separated; no trailing slash.
# Use "null" only if you deliberately support file:// clients.
# ORBIT_ALLOWED_ORIGINS=https://localhost,https://app.example.com

# ---------------------------------------------------------------------------
# Static/native API base
# ---------------------------------------------------------------------------
# Optional absolute API base for static/native builds (RSS + Orbit endpoints).
# Leave empty for same-origin hosting.
# VITE_API_BASE=https://bridge.example.com

# GitHub Pages build only.
# VITE_BASE=/digitalmate-web/
