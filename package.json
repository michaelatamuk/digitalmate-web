{
  "name": "digitalmate-web",
  "private": true,
  "version": "0.2.3",
  "type": "module",
  "description": "Mock-first web companion for the DigitalMate HarmonyOS app.",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "start": "tsx services/bridge/index.ts",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "bridge:fake": "node scripts/fake-orbit.mjs",
    "check:offline": "node scripts/check-offline.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "^8.0.4",
    "fast-xml-parser": "^5.11.2",
    "pdfjs-dist": "^6.4.299",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@capacitor/cli": "^8.6.0",
    "@playwright/test": "^1.64.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "4.3.4",
    "tsx": "^4.23.15",
    "typescript": "5.7.3",
    "vite": "6.0.7",
    "vitest": "^4.1.12"
  }
}
